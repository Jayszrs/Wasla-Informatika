  "narrative": {
    "northStar": "A familiar software-house experience, with Wasla's own work and voice.",
    "overview": "The public site keeps the owner's established software-house composition: photographic opening, centered grid, Poppins hierarchy, real project screenshots, navy/white fields and capsule actions. The latest approved contract replaces service-image tilt with actual Three.js geometry and the connected division diagram with click-to-flip people cards. The header has the left wordmark and static ID marker; the right emblem is removed. The footer is a seamless straight navy region with readable company/navigation/team information and a low-opacity final signature. Public CTA surfaces are White.\n\nWasla Studio is the Operate surface of this identity: concrete tasks, readable forms, predictable navigation, real counts and honest empty states. It is a custom dashboard and internal scheduler, with no Payload runtime. Latest owner direction in `.impeccable/studio-direction.md` supersedes historic canon. This source-extracted record refreshes the existing design system; no new comp or invented photography is claimed.",
    "keyCharacteristics": [
      "Photographic public opening and seven real screenshot projects.",
      "Actual unboxed Three.js service objects with deliberate interaction.",
      "Navy initials or supplied CMS photos in semantic flip cards.",
      "Left header wordmark, White CTAs and a straight navy footer.",
      "Custom Studio Operate workspace with real data and explicit save states."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Technology marks describe studio capabilities, not client relationships or displayed project stacks. Publish only supplied company facts and eligible proof.",
        "section": "colors"
      },
      {
        "name": "The Deliberate Motion Rule",
        "body": "Automatic movement must stop for reduced motion; touch scrolling remains available until the visitor explicitly activates object rotation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve Wasla navy/white, Poppins, the photographic opening and original project covers.",
      "Do keep Three.js geometry, explicit touch activation, keyboard rotation and reduced-motion behavior.",
      "Do use supplied photos or honest initials, manual gallery uploads and independent WhatsApp links.",
      "Do keep Studio forms readable, mobile save controls first and calendar details available in the agenda.",
      "Do preserve published content until an explicit publish action, role restrictions and private data boundaries."
    ],
    "donts": [
      "Don't restore Payload runtime, the right header emblem, the connected tree diagram or raster-only service tilt.",
      "Don't introduce footer waves/seams, gray public CTA blocks, decorative link arrows or fabricated portraits.",
      "Don't invent client work, metrics, schedules, automatic reminders or project stacks.",
      "Don't treat staged runtime verification, local captures or documentation as completed production promotion or DNS."
    ]
  }
