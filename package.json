{
  "name": "wasla-informatika",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests playwright.config.ts next.config.mjs postcss.config.mjs",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:migrate": "payload migrate",
    "db:create-migration": "payload migrate:create",
    "db:local": "node scripts/local-postgres.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "seed": "tsx scripts/seed.ts",
    "seed:media": "tsx scripts/seed-demo-media.ts",
    "seed:real": "tsx scripts/seed-real-content.ts",
    "test": "tsx --test tests/unit.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-nodemailer": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "@payloadcms/storage-vercel-blob": "3.91.0",
    "dotenv": "^17.2.3",
    "graphql": "^16.11.0",
    "next": "16.4.2",
    "payload": "3.91.0",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "^4.3.6"
  },
  "overrides": {
    "sass": "^1.100.0",
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
