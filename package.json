{
  "name": "wasla-informatika",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests playwright.config.ts next.config.mjs postcss.config.mjs",
    "db:migrate": "tsx scripts/setup-studio.ts",
    "db:local": "node scripts/local-postgres.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "seed": "tsx scripts/setup-studio.ts",
    "db:video-gallery": "tsx scripts/seed-video-library.ts",
    "test": "tsx --test tests/unit.test.ts tests/video-media.test.ts",
    "test:e2e": "playwright test",
    "db:import-legacy": "tsx scripts/migrate-studio.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.3",
    "@vercel/speed-insights": "^2.0.0",
    "dotenv": "^17.2.3",
    "next": "16.4.2",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "three": "^0.186.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "sass": "^1.100.0",
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
