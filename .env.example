NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://wasla:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5433/wasla
PAYLOAD_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
POSTGRES_USER=wasla
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=wasla
POSTGRES_PORT=5433
MEDIA_DIR=./media
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
TRUST_PROXY=false
# Vercel persistent media. Runtime enables Blob automatically on Vercel.
BLOB_READ_WRITE_TOKEN=
USE_VERCEL_BLOB=false
# Production object storage. Set all S3 values to enable the adapter.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Optional SMTP, notifications contain no contact message or personal data.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_NOTIFY_EMAIL=
